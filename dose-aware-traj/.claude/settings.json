{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(python scripts/*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(git add*)",
      "Bash(ls*)",
      "Bash(cat*)",
      "Bash(head*)",
      "Bash(tail*)",
      "Bash(wc*)",
      "Bash(which*)",
      "Bash(conda env list*)",
      "Bash(pip list*)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(git push:*)",
      "Bash(git commit --amend*)",
      "Bash(git reset --hard*)",
      "Bash(git checkout main*)",
      "Bash(git rebase*)",
      "Bash(rm -rf*)",
      "Bash(git add -f*)",
      "Read(./.env*)"
    ]
  }
}
